# arc-agents cron entries
# Format: minute hour day month weekday
#
# Install (idempotent, marker-block upsert):
#   bun bin/cron-install.ts install bin/cron/recovery-sweep.cron
# Uninstall:  bun bin/cron-install.ts uninstall recovery-sweep

# recovery-sweep-tick — every 5 min, flips engine-outage-blocked rows back to
# `ready` once their alias is producing work again. See bin/recovery-sweep-tick.sh
# for the manual-run path (force-recover after a known outage resolution).
# PATH pinned: tick spawns bun + provider-alias commands that cron's default
# PATH does not resolve (see commit 87692ef).
*/5 * * * * PATH=/home/aaron/.local/bin:/usr/local/lib/node_modules/node/bin:/usr/local/bin:/usr/bin:/bin /home/aaron/repos/arc-agents/bin/recovery-sweep-tick.sh >> /home/aaron/.cache/arc-recovery-sweep-tick.log 2>&1
