{
  "exec_cli_alias": {
    "fast": ["cli-agent --pool fast {prompt}"],
    "smart": [
      "cli-agent --pool smart {prompt}",
      "claude-afk --model opus -p {prompt}"
    ],
    "opus-max": [
      "cli-agent --pool smart {prompt}",
      "claude-afk --model opus -p {prompt}"
    ],
    "minimax-build": ["cli-agent --pool fast {prompt}"]
  },
  "pool_caps": { "interactive": 6, "ops": 5, "build": 4, "explore": 4, "default": 4 },
  "default_alias": "fast",
  "fast_alias": "fast",
  "smart_alias": "smart"
}
